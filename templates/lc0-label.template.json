{
  "schema": "crucible.template.v1",
  "name": "lc0-label",
  "kind": "lc0-label",
  "description": "Stream LC0 V6 records through Stockfish into deterministic BulletFormat shards",
  "run_name": "lc0-label-{source_stem}-{depth}-{timestamp}",
  "default_workers": "pwa-5090:20,pwa-mbp:8,pwa-mbp0:10",
  "work_dir": "~/.cache/crucible/repos/nnue-13d64ad",
  "path_maps": {
    "pwa-mbp0": {
      "~/.cache/crucible": "~/Library/Caches/crucible"
    },
    "pwa-wsl": {
      "~/.cache/crucible": "/home/petter/.cache/crucible"
    }
  },
  "parameters": {
    "source": {
      "required": true,
      "worker_path": true,
      "help": "Coordinator LC0 training.* corpus directory"
    },
    "output": {
      "required": true,
      "worker_path": true,
      "help": "Final merged BulletFormat output"
    },
    "engine": {
      "default": "stockfish",
      "help": "Stockfish executable name or explicit worker-mapped absolute path"
    },
    "depth": {
      "type": "int",
      "default": 12,
      "help": "Stockfish search depth"
    },
    "threads": {
      "type": "int",
      "default": 1,
      "help": "Stockfish threads per shard"
    },
    "hash": {
      "type": "int",
      "default": 128,
      "help": "Stockfish hash size in MiB per shard"
    },
    "max_records": {
      "type": "int",
      "default": 9000000,
      "help": "Global raw LC0 record limit"
    },
    "min_ply": {
      "type": "int",
      "default": 16,
      "help": "Minimum game ply"
    },
    "quiet_only": {
      "type": "bool",
      "default": true,
      "help": "Keep only quiet positions outside check"
    },
    "shards": {
      "type": "int",
      "default": 152,
      "help": "Number of deterministic file shards"
    }
  },
  "requirements": {
    "python_min": "3.11",
    "git_min": "2.38",
    "repos": [
      {
        "name": "nnue-lc0-labeler",
        "url": "git@github.com:ilAYAli/nnue.git",
        "path": "~/.cache/crucible/repos/nnue-13d64ad",
        "remote": "origin",
        "commit": "13d64ad53087fae86a58dd43cf192ffea1bcf2a0",
        "allow_untracked": true,
        "install_timeout_s": 300,
        "install": [
          "PYTHON=python3; test ! -x /opt/homebrew/bin/python3 || PYTHON=/opt/homebrew/bin/python3; test -x .venv/bin/python || \"$PYTHON\" -m venv .venv; .venv/bin/python -m pip install -q python-chess"
        ],
        "probe": [
          ".venv/bin/python -m unittest tools.tests.test_lc0_streaming"
        ]
      }
    ],
    "commands": [
      {
        "name": "engine",
        "path": "{engine}",
        "command": "test -x {engine} 2>/dev/null || command -v {engine} >/dev/null",
        "timeout_s": 20
      }
    ],
    "inputs": [
      {
        "name": "LC0 inventory cache",
        "path": "{source_cache}",
        "tree": "lc0-inventory",
        "digest": "{inventory_digest}"
      }
    ]
  },
  "task": {
    "split": {
      "total": "max_records",
      "count": "shards",
      "unit": "records"
    },
    "label": "lc0:{shard}",
    "outputs": [
      "{output_dir}/{task_name}.bullet",
      "{output_dir}/{task_name}.stats.json"
    ],
    "command": ".venv/bin/python tools/score/label_lc0.py --input {source_cache} --inventory {inventory} --output {output_dir}/{task_name}.bullet --stats {output_dir}/{task_name}.stats.json --engine {engine} --depth {depth} --threads {threads} --hash {hash} --max-records {max_records} --min-ply {min_ply} {quiet_only_arg} --shard-count {task_count} --shard-index {task_index}",
    "progress": {
      "unit": "records",
      "log_regex": "read=(?P<done>\\d+) selected=(?P<selected>\\d+) written=(?P<output>\\d+) rate=(?P<rate>[0-9.]+)/s",
      "output_unit": "positions",
      "series": [
        {
          "name": "read",
          "field": "done",
          "x": "done",
          "scale": "linear"
        },
        {
          "name": "selected",
          "field": "selected",
          "x": "done",
          "scale": "linear"
        },
        {
          "name": "written",
          "field": "output",
          "x": "done",
          "scale": "linear"
        }
      ]
    }
  },
  "finalize": {
    "type": "lc0-bullet",
    "output": "{output}",
    "inventory_digest": "{inventory_digest}"
  }
}
