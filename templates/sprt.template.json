{
  "schema": "forge.template.v1",
  "name": "sprt",
  "kind": "sprt",
  "description": "Run distributed SPRT game shards",
  "run_name": "sprt-{candidate_stem}-{games}-{timestamp}",
  "work_dir": "~",
  "materialize_inputs": true,
  "chunking": {
    "live_rechunk": true,
    "initial_units": 2,
    "rechunk_chunks_per_slot": 4,
    "min_chunks_per_slot": 2,
    "signature_parameters": [
      "tc",
      "threads",
      "concurrency",
      "restart"
    ]
  },
  "parameters": {
    "chunk_time_seconds": {
      "type": "int",
      "default": 120,
      "help": "Target wall-clock seconds per adaptively sized chunk"
    },
    "candidate": {
      "required": true,
      "path_context": "worker",
      "directory_executable": "build/enyo",
      "help": "Candidate UCI engine executable path or Enyo checkout directory available on all workers"
    },
    "games": {
      "type": "int",
      "required": true,
      "help": "Total games across all tasks"
    },
    "reference": {
      "required": true,
      "path_context": "worker",
      "help": "Reference UCI engine executable"
    },
    "candidate_uci": {
      "repeatable": true,
      "arg": "--candidate-uci",
      "quote": false,
      "file_options": [
        "nnue_file"
      ],
      "help": "Extra candidate UCI option NAME=VALUE. Repeatable."
    },
    "reference_uci": {
      "repeatable": true,
      "arg": "--reference-uci",
      "quote": false,
      "file_options": [
        "nnue_file"
      ],
      "help": "Extra reference UCI option NAME=VALUE. Repeatable."
    },
    "book": {
      "required": true,
      "path_context": "worker",
      "help": "Opening book"
    },
    "book_order": {
      "arg": "--order",
      "choices": [
        "random",
        "sequential"
      ],
      "default": "random",
      "help": "Opening-book order"
    },
    "book_seed": {
      "type": "int",
      "help": "Base opening random seed; defaults to a new run-specific seed and each shard adds its task index"
    },
    "book_offset": {
      "arg": "--book-offset",
      "type": "int",
      "default": 0,
      "help": "Zero-based opening-book offset"
    },
    "shards": {
      "type": "int",
      "aliases": [
        "shard_count"
      ],
      "help": "Number of Forge shards; defaults to about 6 games each until this workload is calibrated and at least two complete configured worker-slot waves"
    },
    "concurrency": {
      "type": "int",
      "default": 1,
      "help": "SPRT concurrency per task"
    },
    "threads": {
      "type": "int",
      "default": 1,
      "help": "Engine threads per game"
    },
    "hash": {
      "type": "int",
      "default": 128,
      "help": "Hash size in MiB for each candidate and reference engine process"
    },
    "tc": {
      "default": "10+0.1",
      "help": "SPRT time control"
    },
    "elo0": {
      "type": "float",
      "default": 0.0,
      "help": "SPRT null-hypothesis Elo"
    },
    "elo1": {
      "type": "float",
      "default": 5.0,
      "help": "SPRT alternative-hypothesis Elo"
    },
    "alpha": {
      "type": "float",
      "default": 0.1,
      "help": "SPRT false-positive probability"
    },
    "beta": {
      "type": "float",
      "default": 0.1,
      "help": "SPRT false-negative probability"
    },
    "restart": {
      "default": "on",
      "help": "SPRT restart mode"
    }
  },
  "requirements": {
    "python_min": "3.11",
    "git_min": "2.38",
    "repos": [
      {
        "name": "sprt",
        "url": "git@github.com:ilAYAli/sprt.git",
        "path": "~/.cache/forge/tools/sprt/a99f574a670e30f3e0699fae891c679de6db5560",
        "remote": "origin",
        "commit": "a99f574a670e30f3e0699fae891c679de6db5560",
        "allow_untracked": true,
        "probe": [
          "./sprt --help | grep -- '--no-ntfy'"
        ]
      },
      {
        "name": "fastchess",
        "url": "https://github.com/Disservin/fastchess.git",
        "path": "~/.cache/forge/tools/fastchess/3de44228aec904e688a4ad71c554eb9d461a5a2a",
        "remote": "origin",
        "commit": "3de44228aec904e688a4ad71c554eb9d461a5a2a",
        "allow_untracked": true,
        "build_timeout_s": 900,
        "install_timeout_s": 120,
        "probe_timeout_s": 30,
        "build": [
          "make -j build=release"
        ],
        "probe": [
          "./fastchess -version | grep fastchess"
        ]
      }
    ],
    "commands": [
      {
        "name": "sprt",
        "path": "~/.cache/forge/tools/sprt/a99f574a670e30f3e0699fae891c679de6db5560/sprt",
        "command": "~/.cache/forge/tools/sprt/a99f574a670e30f3e0699fae891c679de6db5560/sprt --help",
        "contains": "--no-ntfy",
        "timeout_s": 20
      },
      {
        "name": "fastchess",
        "path": "~/.cache/forge/tools/fastchess/3de44228aec904e688a4ad71c554eb9d461a5a2a/fastchess",
        "timeout_s": 20
      },
      {
        "name": "candidate",
        "path": "{candidate}",
        "command": "printf '%s\\n' uci quit | {candidate}",
        "contains": "uciok",
        "timeout_s": 900
      },
      {
        "name": "reference",
        "path": "{reference}",
        "command": "printf '%s\\n' uci quit | {reference}",
        "contains": "uciok",
        "timeout_s": 900
      }
    ],
    "inputs": [
      {
        "name": "book",
        "path": "{book}"
      }
    ]
  },
  "task": {
    "split": {
      "total": "games",
      "count": "shards",
      "unit": "games"
    },
    "resume": {
      "strategy": "split-progress",
      "count_arg": "--games"
    },
    "label": "sprt:{shard}",
    "output": "{output_dir}/{task_name}/logs/{task_name}.log",
    "command": "~/.cache/forge/tools/sprt/a99f574a670e30f3e0699fae891c679de6db5560/sprt --candidate-uci Hash={hash} --reference-uci Hash={hash} {sprt_args} --games {shard} --srand {seed} --book-offset {book_offset} --fastchess ~/.cache/forge/tools/fastchess/3de44228aec904e688a4ad71c554eb9d461a5a2a/fastchess --log-dir {output_dir}/{task_name}/logs --name {task_name} --no-ntfy --no-eta",
    "progress": {
      "unit": "games",
      "log_regex": "\\[\\s*(?P<done>\\d+)\\/(?P<total>\\d+)\\].*?Elo\\s+(?P<elo>[-+]?(?:\\d+(?:\\.\\d+)?|inf|nan))\\s+\\+/-\\s+(?P<ci>[-+]?(?:\\d+(?:\\.\\d+)?|inf|nan))\\s+\\|\\s+LLR\\s+(?P<llr>[+-]?\\d+(?:\\.\\d+)?/[+-]?(?:\\d+(?:\\.\\d+)?|inf|nan)\\s+\\(\\s*[+-]?\\d+(?:\\.\\d+)?%\\))\\s+\\|\\s+LOS\\s+(?P<los>[-+]?(?:\\d+(?:\\.\\d+)?|inf|nan))%(?:\\s+\\|\\s+WDL\\s+(?P<wdl>\\d+/\\d+/\\d+)\\s+\\|\\s+Ptnml\\s+(?P<pentanomial>\\d+-\\d+-\\d+-\\d+-\\d+))?\\s+\\|\\s+draw\\s+(?P<draw>[-+]?(?:\\d+(?:\\.\\d+)?|inf|nan))%(?:.*?ETA\\s+(?P<eta>\\S+))?",
      "series": [
        {
          "name": "llr",
          "field": "llr",
          "x": "done",
          "scale": "symmetric"
        },
        {
          "name": "elo",
          "field": "elo",
          "x": "done",
          "band_max_fraction": 0.24,
          "band_scale": 0.35,
          "band_series": "ci",
          "scale": "symmetric",
          "smooth": true
        },
        {
          "name": "ci",
          "field": "ci",
          "x": "done"
        }
      ]
    }
  }
}
