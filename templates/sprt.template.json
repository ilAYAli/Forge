{
  "schema": "forge.template.v1",
  "name": "sprt",
  "kind": "sprt",
  "description": "Run distributed SPRT game shards",
  "run_name": "sprt-{candidate_stem}-{games}-{timestamp}",
  "work_dir": "~",
  "materialize_inputs": true,
  "parameters": {
    "candidate": {
      "required": true,
      "worker_path": true,
      "directory_executable": "build/enyo",
      "help": "Candidate UCI engine executable path or Enyo checkout directory available on all workers"
    },
    "games": {
      "type": "int",
      "required": true,
      "help": "Total games across all tasks"
    },
    "reference": {
      "default": "~/assets/engines/reference",
      "worker_path": true,
      "help": "Reference UCI engine executable"
    },
    "candidate_uci": {
      "repeatable": true,
      "arg": "--candidate-uci",
      "quote": false,
      "file_options": [
        "nnue_file"
      ],
      "help": "Extra candidate UCI option NAME=VALUE. Repeatable."
    },
    "reference_uci": {
      "repeatable": true,
      "arg": "--reference-uci",
      "quote": false,
      "file_options": [
        "nnue_file"
      ],
      "help": "Extra reference UCI option NAME=VALUE. Repeatable."
    },
    "book": {
      "default": "~/assets/books/AntiDraw_V2.1/WOMP_Openings_V1/WOMP_V1_+150_+159/WOMP_V1_6mvs_big_+140_+169.epd",
      "worker_path": true,
      "help": "Opening book"
    },
    "shards": {
      "type": "int",
      "aliases": ["shard_count"],
      "help": "Number of Forge shards; defaults to about 25 games each and at least two complete configured worker-slot waves"
    },
    "concurrency": {
      "type": "int",
      "default": 1,
      "help": "SPRT concurrency per task"
    },
    "threads": {
      "type": "int",
      "default": 1,
      "help": "Engine threads per game"
    },
    "hash": {
      "type": "int",
      "default": 128,
      "help": "Hash size in MiB for each candidate and reference engine process"
    },
    "tc": {
      "default": "10+0.1",
      "help": "SPRT time control"
    },
    "restart": {
      "default": "on",
      "help": "SPRT restart mode"
    }
  },
  "requirements": {
    "python_min": "3.11",
    "git_min": "2.38",
    "repos": [
      {
        "name": "sprt",
        "url": "git@github.com:ilAYAli/sprt.git",
        "path": "~/.cache/forge/tools/sprt/a42658d7ff09c8334777fccd61e0928cf3108b57",
        "remote": "origin",
        "commit": "a42658d7ff09c8334777fccd61e0928cf3108b57",
        "allow_untracked": true,
        "probe": [
          "./sprt --help | grep -- '--no-ntfy'"
        ]
      },
      {
        "name": "fastchess",
        "url": "https://github.com/Disservin/fastchess.git",
        "path": "~/.cache/forge/tools/fastchess/3de44228aec904e688a4ad71c554eb9d461a5a2a",
        "remote": "origin",
        "commit": "3de44228aec904e688a4ad71c554eb9d461a5a2a",
        "allow_untracked": true,
        "build_timeout_s": 900,
        "install_timeout_s": 120,
        "probe_timeout_s": 30,
        "build": [
          "make -j build=release"
        ],
        "probe": [
          "./fastchess -version | grep fastchess"
        ]
      }
    ],
    "commands": [
      {
        "name": "sprt",
        "path": "~/.cache/forge/tools/sprt/a42658d7ff09c8334777fccd61e0928cf3108b57/sprt",
        "command": "~/.cache/forge/tools/sprt/a42658d7ff09c8334777fccd61e0928cf3108b57/sprt --help",
        "contains": "--no-ntfy",
        "timeout_s": 20
      },
      {
        "name": "fastchess",
        "path": "~/.cache/forge/tools/fastchess/3de44228aec904e688a4ad71c554eb9d461a5a2a/fastchess",
        "timeout_s": 20
      },
      {
        "name": "candidate",
        "path": "{candidate}",
        "command": "engine={candidate}; if probe=$(printf '%s\\n' uci quit | \"$engine\" 2>/dev/null) && printf '%s\\n' \"$probe\" | grep -q uciok; then printf '%s\\n' \"$probe\"; exit 0; fi; name=$(basename \"$engine\"); case \"$name\" in enyo_*) commit=$(printf '%s\\n' \"$name\" | sed 's/^enyo_//') ;; *) echo \"engine is unavailable and cannot be built automatically: $engine\" >&2; exit 1 ;; esac; cd ~/code/cpp/chess/enyo && git fetch origin && git -c advice.detachedHead=false checkout -f \"$commit\" && ./scripts/deploy.sh --candidate && test -x \"$engine\" && printf '%s\\n' uci quit | \"$engine\"",
        "contains": "uciok",
        "timeout_s": 900
      },
      {
        "name": "reference",
        "path": "{reference}",
        "command": "engine={reference}; if probe=$(printf '%s\\n' uci quit | \"$engine\" 2>/dev/null) && printf '%s\\n' \"$probe\" | grep -q uciok; then printf '%s\\n' \"$probe\"; exit 0; fi; name=$(basename \"$engine\"); case \"$name\" in enyo_*) commit=$(printf '%s\\n' \"$name\" | sed 's/^enyo_//') ;; *) echo \"engine is unavailable and cannot be built automatically: $engine\" >&2; exit 1 ;; esac; cd ~/code/cpp/chess/enyo && git fetch origin && git -c advice.detachedHead=false checkout -f \"$commit\" && ./scripts/deploy.sh --candidate && test -x \"$engine\" && printf '%s\\n' uci quit | \"$engine\"",
        "contains": "uciok",
        "timeout_s": 900
      }
    ],
    "inputs": [
      {
        "name": "book",
        "path": "{book}"
      }
    ]
  },
  "task": {
    "split": {
      "total": "games",
      "count": "shards",
      "unit": "games"
    },
    "label": "sprt:{shard}",
    "output": "{output_dir}/{task_name}/logs/{task_name}.log",
    "command": "~/.cache/forge/tools/sprt/a42658d7ff09c8334777fccd61e0928cf3108b57/sprt --candidate-uci Hash={hash} --reference-uci Hash={hash} {sprt_args} --games {shard} --fastchess ~/.cache/forge/tools/fastchess/3de44228aec904e688a4ad71c554eb9d461a5a2a/fastchess --log-dir {output_dir}/{task_name}/logs --name {task_name} --no-ntfy --no-eta",
    "progress": {
      "unit": "games",
      "log_regex": "\\[\\s*(?P<done>\\d+)\\/(?P<total>\\d+)\\].*?Elo\\s+(?P<elo>[-+]?(?:\\d+(?:\\.\\d+)?|inf|nan))\\s+\\+/-\\s+(?P<ci>[-+]?(?:\\d+(?:\\.\\d+)?|inf|nan))\\s+\\|\\s+LLR\\s+(?P<llr>[+-]?\\d+(?:\\.\\d+)?/[+-]?(?:\\d+(?:\\.\\d+)?|inf|nan)\\s+\\(\\s*[+-]?\\d+(?:\\.\\d+)?%\\))\\s+\\|\\s+LOS\\s+(?P<los>[-+]?(?:\\d+(?:\\.\\d+)?|inf|nan))%\\s+\\|\\s+draw\\s+(?P<draw>[-+]?(?:\\d+(?:\\.\\d+)?|inf|nan))%(?:.*?ETA\\s+(?P<eta>\\S+))?",
      "series": [
        {
          "name": "llr",
          "field": "llr",
          "x": "done",
          "scale": "symmetric"
        },
        {
          "name": "elo",
          "field": "elo",
          "x": "done",
          "band_max_fraction": 0.24,
          "band_scale": 0.35,
          "band_series": "ci",
          "scale": "symmetric",
          "smooth": true
        },
        {
          "name": "ci",
          "field": "ci",
          "x": "done"
        }
      ]
    }
  }
}
