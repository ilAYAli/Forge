{
  "schema": "forge.template.v1",
  "name": "tb-sf-oracle-relabel",
  "kind": "sf-oracle-relabel",
  "description": "Convert Enyo self-play PGN shards to Bullet, applying Syzygy WDL only to <=6-piece positions and preserving all other input labels",
  "run_name": "tb-sf-oracle-relabel-{timestamp}",
  "work_dir": "{work_dir}",
  "parameters": {
    "work_dir": {
      "required": true,
      "path_context": "worker"
    },
    "pgn_dir": {
      "required": true,
      "path_context": "worker"
    },
    "output": {
      "required": true,
      "path_context": "worker"
    },
    "sf_engine": {
      "required": true
    },
    "sf_net": {
      "required": true
    },
    "sf_hash": {
      "type": "int",
      "default": 64
    },
    "tb_pieces": {
      "type": "int",
      "default": 6
    },
    "skip_plies": {
      "type": "int",
      "default": 8
    },
    "min_depth": {
      "type": "int",
      "default": 1
    },
    "max_abs_cp": {
      "type": "int",
      "default": 10000
    },
    "shards": {
      "aliases": [
        "shard_count"
      ],
      "type": "int"
    }
  },
  "task": {
    "split": {
      "count": "shards"
    },
    "label": "tb-sf-oracle:{shard}",
    "outputs": [
      "{output_dir}/{task_name}.bullet"
    ],
    "command": ".venv/bin/python3 tools/bullet/selfplay_to_bullet_tb.py --pgn-dir {pgn_dir} --output {output_dir}/{task_name}.bullet --shard-slice {task_index}/{task_count} --tb-pieces {tb_pieces} --skip-plies {skip_plies} --min-depth {min_depth} --max-abs-cp {max_abs_cp}",
    "progress": {
      "unit": "positions",
      "log_regex": "read=(?P<done>\\d+) selected=(?P<selected>\\d+) written=(?P<output>\\d+) rate=(?P<rate>[0-9.]+)/s",
      "series": [
        {
          "name": "labels/s",
          "field": "rate",
          "x": "done",
          "scale": "linear"
        }
      ]
    }
  },
  "finalize": {
    "type": "bullet-labels",
    "output": "{output}"
  }
}
