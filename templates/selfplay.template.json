{
  "schema": "forge.template.v1",
  "name": "selfplay",
  "kind": "selfplay",
  "description": "Generate distributed Enyo self-play PGNs",
  "run_name": "selfplay-{engine_stem}-{games}-{timestamp}",
  "work_dir": "~",
  "materialize_inputs": true,
  "chunking": {
    "live_rechunk": true,
    "initial_units": 15,
    "rechunk_chunks_per_slot": 4
  },
  "parameters": {
    "engine": {
      "required": true,
      "local_default": true,
      "path_context": "worker",
      "directory_executable": "build/enyo",
      "help": "Enyo UCI engine executable or checkout directory available on all workers"
    },
    "games": {
      "type": "int",
      "default": 300000,
      "help": "Total self-play games across all shards; must be even"
    },
    "shards": {
      "type": "int",
      "aliases": [
        "shard_count"
      ],
      "help": "Number of Forge shards; defaults from recent throughput history to a target chunk time"
    },
    "chunk_time_seconds": {
      "type": "int",
      "default": 300,
      "help": "Target wall-clock seconds per shard when auto-sizing selfplay chunks"
    },
    "book": {
      "required": true,
      "local_default": true,
      "path_context": "worker",
      "help": "EPD opening book"
    },
    "book_order": {
      "default": "random",
      "help": "Fastchess opening order"
    },
    "seed": {
      "type": "int",
      "default": 1,
      "help": "Fastchess opening random seed"
    },
    "concurrency": {
      "type": "int",
      "default": 1,
      "help": "Concurrent games inside each shard"
    },
    "threads": {
      "type": "int",
      "default": 1,
      "help": "Engine threads per game"
    },
    "hash": {
      "type": "int",
      "default": 128,
      "help": "Hash size in MiB for each engine process"
    },
    "tc": {
      "default": "10+0.1",
      "help": "Fastchess time control; ignored when depth or nodes is set"
    },
    "depth": {
      "type": "int",
      "help": "Fixed search depth per move (fastchess tc=inf depth=N); takes priority over nodes and tc"
    },
    "nodes": {
      "type": "int",
      "default": 5000,
      "help": "Fixed node budget per move (fastchess tc=inf nodes=N); used when depth is unset, takes priority over tc"
    },
    "restart": {
      "default": "off",
      "help": "Engine restart mode"
    },
    "pgn_notation": {
      "default": "uci",
      "help": "PGN notation written by fastchess"
    },
    "fastchess": {
      "default": "~/.cache/forge/tools/fastchess/3de44228aec904e688a4ad71c554eb9d461a5a2a/fastchess",
      "path_context": "worker",
      "help": "Fastchess executable"
    },
    "uci": {
      "repeatable": true,
      "default": [],
      "arg": "--uci",
      "file_options": [
        "nnue_file"
      ],
      "help": "Common UCI option applied to both self-play engines as NAME=VALUE; repeatable"
    }
  },
  "requirements": {
    "python_min": "3.11",
    "git_min": "2.38",
    "repos": [
      {
        "name": "fastchess",
        "url": "https://github.com/Disservin/fastchess.git",
        "path": "~/.cache/forge/tools/fastchess/3de44228aec904e688a4ad71c554eb9d461a5a2a",
        "remote": "origin",
        "commit": "3de44228aec904e688a4ad71c554eb9d461a5a2a",
        "allow_untracked": true,
        "build_timeout_s": 900,
        "install_timeout_s": 120,
        "probe_timeout_s": 30,
        "build": [
          "make -j build=release"
        ],
        "probe": [
          "./fastchess -version | grep fastchess"
        ]
      }
    ],
    "commands": [
      {
        "name": "fastchess",
        "path": "{fastchess}",
        "timeout_s": 20
      },
      {
        "name": "engine",
        "path": "{engine}",
        "command": "printf '%s\\n' uci quit | {engine}",
        "contains": "uciok",
        "timeout_s": 900
      }
    ],
    "inputs": [
      {
        "name": "book",
        "path": "{book}"
      }
    ]
  },
  "task": {
    "split": {
      "total": "games",
      "count": "shards",
      "unit": "games"
    },
    "prefix": "selfplay",
    "label": "selfplay:{shard}",
    "output": "{output_dir}/{task_name}.pgn",
    "command": "{fastchess_shell} -engine cmd={engine_shell} name=enyo-a option.Hash={hash} option.Threads={threads} {uci_args} -engine cmd={engine_shell} name=enyo-b option.Hash={hash} option.Threads={threads} {uci_args} -each {limit_args} proto=uci restart={restart_shell} -rounds {shard_pairs} -games 2 -recover -openings file={book_shell} format=epd order={book_order_shell} -srand {seed} -concurrency {concurrency} -pgnout file=\"{output_dir}/{task_name}.pgn\" notation={pgn_notation_shell} -output format=fastchess",
    "progress": {
      "unit": "games",
      "log_regex": "Games:\\s+(?P<done>\\d+),\\s+Wins:\\s+(?P<wins>\\d+),\\s+Losses:\\s+(?P<losses>\\d+),\\s+Draws:\\s+(?P<draws>\\d+)",
      "series": [
        {
          "name": "wins",
          "field": "wins",
          "x": "done",
          "scale": "linear"
        },
        {
          "name": "losses",
          "field": "losses",
          "x": "done",
          "scale": "linear"
        },
        {
          "name": "draws",
          "field": "draws",
          "x": "done",
          "scale": "linear"
        },
        {
          "name": "rate",
          "field": "rate",
          "x": "done",
          "scale": "linear"
        }
      ]
    }
  }
}
