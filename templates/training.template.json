{
  "schema": "crucible.template.v1",
  "name": "training",
  "kind": "training",
  "description": "Run an NNUE build.py create job",
  "run_name": "training-{config_stem}-{timestamp}",
  "work_dir": "{work_dir}",
  "parameters": {
    "config": {
      "default": "build.json",
      "help": "NNUE build.py create config"
    },
    "work_dir": {
      "default": "~/code/cpp/chess/nnue",
      "help": "NNUE repository directory"
    }
  },
  "task": {
    "split": {
      "count": 1
    },
    "label": "training",
    "command": "./build.py create -c {config}",
    "progress": {
      "unit": "steps",
      "log_regex": "(?:step|batch|epoch)=(?P<done>\\d+)(?:/(?P<total>\\d+))?.*?(?:loss|train_loss)=(?P<loss>[-+]?(?:(?:\\d+(?:\\.\\d+)?)|(?:\\.\\d+))(?:[eE][-+]?\\d+)?|inf|nan)(?:.*?lr=(?P<lr>[-+]?(?:(?:\\d+(?:\\.\\d+)?)|(?:\\.\\d+))(?:[eE][-+]?\\d+)?|inf|nan))?",
      "series": [
        {
          "name": "loss",
          "field": "loss",
          "x": "done"
        },
        {
          "name": "lr",
          "field": "lr",
          "x": "done"
        }
      ]
    }
  }
}
